        ],
        "expected_llm_calls": 0
    },
        {
        "name": "unknown_input_calls_llm",
        "category": "fallback",
        "inputs": [
            "¿Cuál es la capital de Francia?"
        ],
        "expected_output": [
            "Respuesta simulada"
        ],
        "expected_llm_calls": 1
    },
    {
        "name": "multiple_unknown_inputs_call_llm_each_time",
